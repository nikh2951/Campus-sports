# Google OAuth Client ID Configuration Example
# Replace with your real Google Cloud OAuth 2.0 Client ID for local development (http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Backend API Base URL
# In production on Vercel, set to: https://campus-sports-production.up.railway.app/api
# In local dev: http://localhost:8080/api
VITE_API_BASE_URL=https://campus-sports-production.up.railway.app/api
